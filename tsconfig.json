{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node", "mocha", "chai"],
    "lib": ["ES2022"]
  },
  "ts-node": {
    "esm": true,
    "compilerOptions": {
      "module": "ES2022"
    }
  },
  "include": ["tests/**/*.ts"]
}
